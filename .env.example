# Discord User ID for the live presence card.
# Enable Developer Mode in Discord, right-click your profile, then "Copy User ID".
# You also need to join https://discord.gg/lanyard or Lanyard cannot read your presence.
VITE_DISCORD_USER_ID=

# Local development only. Set to "false" to see the offline state instead of preview data.
VITE_DEMO_FALLBACK=true

# Server-side only. Never add the VITE_ prefix: this URL is a secret.
# Discord → Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=

# Optional. The MyAnimeList username used by /api/mal.
# It defaults to the username in src/config.js.
MAL_USERNAME=
